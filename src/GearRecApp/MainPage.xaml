<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GearRecApp.MainPage"
             Title="Gear Guru">

    <Grid>
        <!-- Background image -->
        <Image Source="geargurubg.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- Dark overlay for readability -->
        <BoxView BackgroundColor="#66000000"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Hero Header -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 14,14,14,14"
                    BackgroundColor="#AA3D6B4F"
                    Padding="24,28">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Gear Guru"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Skip the search, start the journey"
                           FontSize="13"
                           TextColor="#C8E6C9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Accent bar -->
            <BoxView HeightRequest="3" CornerRadius="2" BackgroundColor="#3D6B4F" HorizontalOptions="Center" WidthRequest="60" />

            <!-- Gear Type Picker -->
            <Border Stroke="#D9D9D9" StrokeThickness="1" StrokeShape="RoundRectangle 12,12,12,12" BackgroundColor="White" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="What gear type are you looking for?"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#3D6B4F" />
                    <Picker x:Name="GearTypePicker"
                            Title="Select gear type"
                            BackgroundColor="White">
                        <Picker.Items>
                            <x:String>Backpack</x:String>
                            <x:String>Tent</x:String>
                            <x:String>Sleeping Bag</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Divider -->
            <BoxView HeightRequest="1" BackgroundColor="#C8E6C9" />

            <!-- Priority Ranking -->
            <Border Stroke="#D9D9D9" StrokeThickness="1" StrokeShape="RoundRectangle 12,12,12,12" BackgroundColor="White" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Priority Ranking: (Top = highest priority.)"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#3D6B4F" />

                    <!-- Row 1 -->
                    <Border Stroke="#D9D9D9"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            BackgroundColor="White"
                            Padding="0">
                        <Grid ColumnDefinitions="6,*,Auto,8,Auto">
                            <BoxView BackgroundColor="#3D6B4F" />
                            <Label Grid.Column="1" x:Name="Priority1Label" Text="1. Rating" VerticalOptions="Center" Margin="12,10" />
                            <Button Grid.Column="2" Text="▲" x:Name="Row1_Up"   Clicked="OnMoveUp"   WidthRequest="40" HeightRequest="36" Padding="0" BackgroundColor="#3D6B4F" TextColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="#3D6B4F" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#6AAF82" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                            <Button Grid.Column="4" Text="▼" x:Name="Row1_Down" Clicked="OnMoveDown" WidthRequest="40" HeightRequest="36" Padding="0" BackgroundColor="#3D6B4F" TextColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="#3D6B4F" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#C0392B" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 2 -->
                    <Border Stroke="#D9D9D9"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            BackgroundColor="White"
                            Padding="0">
                        <Grid ColumnDefinitions="6,*,Auto,8,Auto">
                            <BoxView BackgroundColor="#3D6B4F" />
                            <Label Grid.Column="1" x:Name="Priority2Label" Text="2. Weight" VerticalOptions="Center" Margin="12,10" />
                            <Button Grid.Column="2" Text="▲" x:Name="Row2_Up"   Clicked="OnMoveUp"   WidthRequest="40" HeightRequest="36" Padding="0" BackgroundColor="#3D6B4F" TextColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="#3D6B4F" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#6AAF82" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                            <Button Grid.Column="4" Text="▼" x:Name="Row2_Down" Clicked="OnMoveDown" WidthRequest="40" HeightRequest="36" Padding="0" BackgroundColor="#3D6B4F" TextColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="#3D6B4F" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#C0392B" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 3 -->
                    <Border Stroke="#D9D9D9"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10,10,10,10"
                            BackgroundColor="White"
                            Padding="0">
                        <Grid ColumnDefinitions="6,*,Auto,8,Auto">
                            <BoxView BackgroundColor="#3D6B4F" />
                            <Label Grid.Column="1" x:Name="Priority3Label" Text="3. Price" VerticalOptions="Center" Margin="12,10" />
                            <Button Grid.Column="2" Text="▲" x:Name="Row3_Up"   Clicked="OnMoveUp"   WidthRequest="40" HeightRequest="36" Padding="0" BackgroundColor="#3D6B4F" TextColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="#3D6B4F" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#6AAF82" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                            <Button Grid.Column="4" Text="▼" x:Name="Row3_Down" Clicked="OnMoveDown" WidthRequest="40" HeightRequest="36" Padding="0" BackgroundColor="#3D6B4F" TextColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="#3D6B4F" /></VisualState.Setters></VisualState>
                                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#C0392B" /></VisualState.Setters></VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Divider -->
            <BoxView HeightRequest="1" BackgroundColor="#C8E6C9" />

            <!-- Additional Info -->
            <Border Stroke="#D9D9D9" StrokeThickness="1" StrokeShape="RoundRectangle 12,12,12,12" BackgroundColor="White" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Additional Information:"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#3D6B4F" />
                    <Editor x:Name="AdditionalInfoEditor"
                            Placeholder="e.g. I camp in 3-season conditions, want something under 3 lbs, budget is $300..."
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100"
                            BackgroundColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Submit Button -->
            <Button x:Name="RecommendBtn"
                    Text="Get Recommendation"
                    Clicked="OnRecommendClicked"
                    HorizontalOptions="Fill"
                    CornerRadius="24"
                    FontSize="16"
                    Padding="0,16"
                    BackgroundColor="#AA3D6B4F"
                    TextColor="White">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#AA3D6B4F" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#CC5D9B6F" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>

            <!-- TODO: REMOVE - token debug info (start) -->
            <Label x:Name="TokenLabel"
                   Text=""
                   FontSize="11"
                   TextColor="Gray"
                   IsVisible="False" />
            <!-- TODO: REMOVE - token debug info (end) -->

            <!-- Status / error message -->
            <Editor x:Name="StatusLabel"
                    Text=""
                    TextColor="Red"
                    IsVisible="False"
                    IsReadOnly="True"
                    AutoSize="TextChanges"
                    BackgroundColor="#FFF0F0" />

            <!-- Gear recommendation cards -->
            <VerticalStackLayout x:Name="CardsContainer" Spacing="16" />

            <!-- Start Over Button -->
            <Button x:Name="ResetBtn"
                    Text="Start Over"
                    Clicked="OnResetClicked"
                    HorizontalOptions="Start"
                    WidthRequest="130"
                    BackgroundColor="#B71C1C"
                    TextColor="White"
                    IsVisible="False" />

        </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
